KITE_X402_TOKEN=0x0fF5393387ad2f9f691FD6Fd28e07E3969e27e63
NEXT_PUBLIC_KITE_X402_TOKEN=0x0fF5393387ad2f9f691FD6Fd28e07E3969e27e63
KITE_FACILITATOR_URL=https://facilitator.pieverse.io
# Optional: official Kite x402 demo resource (documentation / future tools)
KITE_X402_DEMO_API=https://x402.dev.gokite.ai/api/weather
#
# LLM (Groq — server-side agent)
GROQ_API_KEY=

# Goal agent tools (Tavily search + Firecrawl scrape)
TAVILY_API_KEY=
FIRECRAWL_API_KEY=

# Server→self HTTP base (goal agent → /api/x402/*). 
INTERNAL_API_BASE_URL=
# Canonical site URL (browser + x402 resource field).
NEXT_PUBLIC_APP_URL=
# NEXT_PUBLIC_GITHUB_REPO_URL=
# Optional override (default: openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b

# Kite chain (use NEXT_PUBLIC_* for values read in the browser)
KITE_RPC_URL=https://rpc-testnet.gokite.ai
NEXT_PUBLIC_KITE_RPC_URL=https://rpc-testnet.gokite.ai
KITE_CHAIN_ID=2368
NEXT_PUBLIC_KITE_CHAIN_ID=2368
KITE_EXPLORER_URL=https://testnet.kitescan.ai
NEXT_PUBLIC_KITE_EXPLORER_URL=https://testnet.kitescan.ai

# Kite public gasless relayer .
# the app uses a standard ERC-20 transfer from the user wallet (user pays KITE gas). 
# KITE_RELAYER_URL=
# NEXT_PUBLIC_KITE_RELAYER_URL=

# EIP-712 domain of the deployed USDT token (must match token.name() / version on-chain)
NEXT_PUBLIC_KITE_TOKEN_DOMAIN_NAME=PYUSD
NEXT_PUBLIC_KITE_TOKEN_DOMAIN_VERSION=1

# Testnet USDT / PYUSD (EIP-712 domain name/version below are fallbacks for x402 agent signing).
# If unset, the app uses the Kite testnet USDT default (same address as KITE_X402_TOKEN above).
# Confirm the live address on https://testnet.kitescan.ai or Kite docs if the faucet changes.
KITE_USDT_CONTRACT=
NEXT_PUBLIC_KITE_USDT_CONTRACT=

# Deploy attestation contract to Kite testnet (needs testnet KITE for gas on deployer wallet):
#   npm run compile:contracts && npm run deploy:contracts
# Then paste printed address into KITE_ATTESTATION_CONTRACT + NEXT_PUBLIC_KITE_ATTESTATION_CONTRACT.
# Optional local Hardhat chain: terminal A `npm run node:hardhat`, terminal B `npm run deploy:contracts:localhost`
# (chain 31337 — only for contract dev; KiteDesk UI targets chain 2368 by default).
DEPLOYER_PRIVATE_KEY=

# After deploy, paste the printed address.
KITE_ATTESTATION_CONTRACT=
NEXT_PUBLIC_KITE_ATTESTATION_CONTRACT=

# Server-only: signs attestTask — must be contract owner (same as deployer for default deploy).
ATTESTATION_SIGNER_PRIVATE_KEY=

# Receives USDT from users 
NEXT_PUBLIC_PLATFORM_WALLET=

# Supabase (payment replay + task history). 
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: direct Postgres URL from Supabase (Settings → Database). URL-encode special chars in password.
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.<project-ref>.supabase.co:5432/postgres

# Session Keys (Account Abstraction for autonomous x402 payments)
# Generate encryption secret: openssl rand -base64 32
SESSION_KEY_ENCRYPTION_SECRET=
# Deploy with: npm run deploy:contracts then paste printed address
SESSION_KEY_VALIDATOR_ADDRESS=
NEXT_PUBLIC_SESSION_KEY_VALIDATOR_ADDRESS=

# Optional local dev (WSL2): if Next misses file saves, try NEXT_DEV_WSL_POLL=1 with npm run dev (see next.config.mjs).

